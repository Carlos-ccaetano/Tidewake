# Safe local PostgreSQL defaults used by docker-compose.yml and Mix.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=tidewake_dev
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Local-only API token for development. Never use in production.
TIDEWAKE_API_TOKEN=dev-only-api-token-not-for-production

# Placeholder for the webhook signing secret. Replace it outside source control.
TIDEWAKE_WEBHOOK_SIGNING_SECRET=replace-with-at-least-32-random-bytes

# Production examples. Replace these values in the deployment environment.
DATABASE_URL=ecto://postgres:replace-me@database.example.com/tidewake
PHX_HOST=tidewake.example.com
PORT=4000
SECRET_KEY_BASE=replace-with-the-output-of-mix-phx-gen-secret
